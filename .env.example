# Display name used in the header, footer and page titles until the brand is confirmed.
VITE_SITE_NAME=Your brand
# Public origin used for canonical and Open Graph URLs (no trailing slash).
VITE_SITE_URL=https://example.vercel.app
# WhatsApp number in international format without "+" (e.g. 91XXXXXXXXXX).
# When empty, WhatsApp links open WhatsApp's share screen instead of a chat.
VITE_WHATSAPP_NUMBER=
